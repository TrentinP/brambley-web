---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JournalEntryLayout from '../../components/JournalEntryLayout.astro';
import JournalIllustration from '../../components/JournalIllustration.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import type { NoteCategory } from '../../lib/notesTaxonomy';
import '../../styles/notes.css';
import '../../styles/note-entry.css';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);

  return notes.map((entry) => ({
    params: { slug: entry.id },
    props: { entry }
  }));
}

interface Props {
  entry: CollectionEntry<'notes'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const category = (entry.data.category ?? 'chronicle') as NoteCategory;
---

<BaseLayout
  title={`${entry.data.title} | Brambley Notes`}
  description={entry.data.excerpt ?? 'A note from Brambley.'}
  bodyClass="notes-page-body"
>
  <JournalEntryLayout
    title={entry.data.title}
    date={entry.data.date}
    subtitle={entry.data.subtitle}
    category={category}
    heroArt={entry.data.hero_art}
    heroArtAlt={entry.data.hero_art_alt}
    heroArtCaption={entry.data.hero_art_caption}
  >
    <Content components={{ JournalIllustration }} />
  </JournalEntryLayout>
</BaseLayout>
