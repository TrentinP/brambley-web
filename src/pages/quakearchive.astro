---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/migration-stub.css';
---
<BaseLayout title="Archive of Notable Earthquakes | Brambley" bodyClass="migration-stub-body">
  <main class="migration-stub">
    <div class="migration-stub__inner">
      <div class="migration-stub__eyebrow">BRAMBLEY MIGRATION PREVIEW</div>
      <h1>Archive of Notable Earthquakes</h1>
      <p>The existing earthquake archive and waveform records will be migrated here while preserving the current retention logic.</p>
      <nav aria-label="Migration preview navigation">
        <a href="/">Brambley</a>
        <a href="/observatory">Observatory</a>
      </nav>
    </div>
  </main>
</BaseLayout>