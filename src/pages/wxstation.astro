---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/migration-stub.css';
---
<BaseLayout title="Weather Station | Brambley" bodyClass="migration-stub-body">
  <main class="migration-stub">
    <div class="migration-stub__inner">
      <div class="migration-stub__eyebrow">BRAMBLEY MIGRATION PREVIEW</div>
      <h1>Weather Station</h1>
      <p>The existing Brambley weather interface and data pipeline are being moved here in the next migration phase.</p>
      <nav aria-label="Migration preview navigation">
        <a href="/">Brambley</a>
        <a href="/observatory">Observatory</a>
      </nav>
    </div>
  </main>
</BaseLayout>