---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/about.css';
---
<BaseLayout title="About Brambley" bodyClass="about-page-body">
  <main class="brambley-about-page">
    <div class="brambley-about-folio">
      <img class="brambley-about-art" src="/assets/about/about-folio-placeholder.svg" alt="About Brambley migration placeholder" />
    </div>
    <div class="brambley-return-home">
      <a href="/">Return to Brambley <span aria-hidden="true">→</span></a>
    </div>
  </main>
</BaseLayout>