---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/migration-stub.css';
---
<BaseLayout title="Weather Data Archive | Brambley" bodyClass="migration-stub-body">
  <main class="migration-stub">
    <div class="migration-stub__inner">
      <div class="migration-stub__eyebrow">BRAMBLEY MIGRATION PREVIEW</div>
      <h1>Weather Data Archive</h1>
      <p>The existing daily and historical weather archive will be migrated here without changing the source data repositories.</p>
      <nav aria-label="Migration preview navigation">
        <a href="/">Brambley</a>
        <a href="/observatory">Observatory</a>
      </nav>
    </div>
  </main>
</BaseLayout>