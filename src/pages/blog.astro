---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrambleyJournalNav from '../components/BrambleyJournalNav.astro';
import '../styles/notes.css';

const journals = [
  {
    slug: 'garden',
    title: 'Garden Book',
    caption: 'Plantings, orchard notes, and seasonal work.',
    image: '/assets/notes/book-garden.webp',
    imageClass: 'journal-book-image--garden'
  },
  {
    slug: 'science',
    title: 'Science Field Notes',
    caption: 'Meteorology, seismology, and observations.',
    image: '/assets/notes/book-science.webp',
    imageClass: 'journal-book-image--science'
  },
  {
    slug: 'chronicle',
    title: 'Chronicle',
    caption: 'Projects, happenings, and records.',
    image: '/assets/notes/book-chronicle.webp',
    imageClass: 'journal-book-image--chronicle'
  }
];
---

<BaseLayout
  title="Notes from Brambley"
  description="Field journals, observations, and records kept around Brambley."
  bodyClass="notes-page-body"
>
  <main class="notes-landing">
    <BrambleyJournalNav active="notes" />

    <header class="notes-hero">
      <h1>Notes from Brambley</h1>
      <img
        class="notes-ornament"
        src="/assets/notes/ornament.webp"
        alt=""
        aria-hidden="true"
      />
      <p>Field journals, observations, and records kept around Brambley.</p>
    </header>

    <section class="journal-collection" aria-label="Brambley journals">
      {journals.map((journal) => (
        <a
          class={`journal-volume journal-volume--${journal.slug}`}
          href={`/blog/${journal.slug}/`}
          aria-label={`Open ${journal.title}`}
        >
          <span class="journal-book-frame">
            <img
              class={`journal-book-image ${journal.imageClass}`}
              src={journal.image}
              alt={journal.title}
            />
          </span>

          <span class="journal-volume-caption">
            <span>{journal.caption}</span>
            <span class="journal-volume-arrow" aria-hidden="true">→</span>
          </span>
        </a>
      ))}
    </section>

    <img
      class="notes-landscape"
      src="/assets/notes/landscape.webp"
      alt=""
      aria-hidden="true"
    />
  </main>
</BaseLayout>
