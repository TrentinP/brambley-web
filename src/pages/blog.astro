---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/migration-stub.css';
---
<BaseLayout title="Notes | Brambley" bodyClass="migration-stub-body">
  <main class="migration-stub">
    <div class="migration-stub__inner">
      <div class="migration-stub__eyebrow">BRAMBLEY MIGRATION PREVIEW</div>
      <h1>Notes</h1>
      <p>The Brambley journal is reserved here for migration after the core site and Observatory pages are stable.</p>
      <nav aria-label="Migration preview navigation">
        <a href="/">Brambley</a>
        <a href="/observatory">Observatory</a>
      </nav>
    </div>
  </main>
</BaseLayout>