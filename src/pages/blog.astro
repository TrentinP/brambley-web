---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/notes.css';

const journals = [
  {
    slug: 'garden',
    title: 'Garden Book',
    caption: 'Plantings, orchard notes, and seasonal work.',
    cropClass: 'notes-mobile-book--garden'
  },
  {
    slug: 'science',
    title: 'Science Field Notes',
    caption: 'Meteorology, seismology, and observations.',
    cropClass: 'notes-mobile-book--science'
  },
  {
    slug: 'chronicle',
    title: 'Chronicle',
    caption: 'Projects, happenings, and records.',
    cropClass: 'notes-mobile-book--chronicle'
  }
];
---

<BaseLayout
  title="Notes from Brambley"
  description="Field journals, observations, and records kept around Brambley."
  bodyClass="notes-page-body"
>
  <main class="notes-landing">
    <section class="notes-approved-desktop" aria-label="Notes from Brambley">
      <img
        class="notes-approved-desktop-art"
        src="/assets/notes/notes-landing.webp"
        alt="Notes from Brambley, illustrated as three painted field journals on warm paper"
      />

      <nav class="art-nav-hotspots" aria-label="Brambley navigation">
        <a class="art-nav-hotspot art-nav-hotspot--home" href="/" aria-label="Home"></a>
        <a class="art-nav-hotspot art-nav-hotspot--observatory" href="/observatory" aria-label="Observatory"></a>
        <a class="art-nav-hotspot art-nav-hotspot--about" href="/about" aria-label="About"></a>
        <a class="art-nav-hotspot art-nav-hotspot--notes" href="/blog" aria-label="Notes" aria-current="page"></a>
      </nav>

      <a
        class="desktop-journal-hotspot desktop-journal-hotspot--garden"
        href="/blog/garden/"
        aria-label="Open the Garden Book"
      ></a>
      <a
        class="desktop-journal-hotspot desktop-journal-hotspot--science"
        href="/blog/science/"
        aria-label="Open Science Field Notes"
      ></a>
      <a
        class="desktop-journal-hotspot desktop-journal-hotspot--chronicle"
        href="/blog/chronicle/"
        aria-label="Open the Chronicle"
      ></a>
    </section>

    <section class="notes-mobile" aria-label="Notes from Brambley">
      <nav class="notes-mobile-nav" aria-label="Brambley navigation">
        <a href="/">Home</a>
        <a href="/observatory">Observatory</a>
        <a href="/about">About</a>
        <a href="/blog" aria-current="page">Notes</a>
      </nav>

      <header class="notes-mobile-header">
        <h1>Notes from Brambley</h1>
        <span class="notes-mobile-ornament" aria-hidden="true"></span>
        <p>Field journals, observations, and records kept around Brambley.</p>
      </header>

      <div class="notes-mobile-journals">
        {journals.map((journal) => (
          <a class="notes-mobile-journal" href={`/blog/${journal.slug}/`}>
            <span
              class={`notes-mobile-book ${journal.cropClass}`}
              role="img"
              aria-label={journal.title}
            ></span>
            <span class="notes-mobile-caption">
              <span>{journal.caption}</span>
              <span class="notes-mobile-arrow" aria-hidden="true">→</span>
            </span>
          </a>
        ))}
      </div>

      <span class="notes-mobile-landscape" aria-hidden="true"></span>
    </section>
  </main>
</BaseLayout>
