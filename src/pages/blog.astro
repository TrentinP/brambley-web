---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrambleyJournalNav from '../components/BrambleyJournalNav.astro';
import BlackberryOrnament from '../components/BlackberryOrnament.astro';
import FolioLandscape from '../components/FolioLandscape.astro';
import JournalCover from '../components/JournalCover.astro';
import '../styles/notes.css';
---

<BaseLayout
  title="Notes from Brambley"
  description="Field journals, observations, and records kept around Brambley."
  bodyClass="notes-page-body"
>
  <main class="notes-landing">
    <BrambleyJournalNav active="notes" />

    <header class="notes-landing-hero">
      <h1>Notes from Brambley</h1>
      <BlackberryOrnament />
      <p>Field journals, observations, and records kept around Brambley.</p>
    </header>

    <section class="journal-collection" aria-label="Brambley journals">
      <a class="journal-volume journal-volume--garden" href="/blog/garden/">
        <span class="journal-volume-art">
          <svg class="pressed-leaf-art" viewBox="0 0 150 250" aria-hidden="true" focusable="false">
            <path d="M90 229C76 181 62 128 47 66" />
            <path d="M54 99C27 96 13 81 5 58c25 0 43 13 49 41Z" />
            <path d="M62 128c-27 2-45-8-56-29 25-6 45 4 56 29Z" />
            <path d="M72 160c-24 7-42 1-56-17 22-9 42-3 56 17Z" />
            <path d="M48 68c8-27 25-42 49-45 0 25-16 42-49 45Z" />
            <path d="M58 106c9-26 26-39 50-40-2 25-18 39-50 40Z" />
            <path d="M67 139c10-23 26-34 48-33-3 22-19 34-48 33Z" />
          </svg>
          <JournalCover category="garden" />
        </span>
        <span class="journal-volume-caption">
          <span>Plantings, orchard notes, and seasonal work.</span>
          <span class="journal-volume-arrow" aria-hidden="true">→</span>
        </span>
      </a>

      <a class="journal-volume journal-volume--science" href="/blog/science/">
        <span class="journal-volume-art">
          <JournalCover category="science" />
        </span>
        <span class="journal-volume-caption">
          <span>Meteorology, seismology, and observations.</span>
          <span class="journal-volume-arrow" aria-hidden="true">→</span>
        </span>
      </a>

      <a class="journal-volume journal-volume--chronicle" href="/blog/chronicle/">
        <span class="journal-volume-art">
          <JournalCover category="chronicle" />
        </span>
        <span class="journal-volume-caption">
          <span>Projects, happenings, and records.</span>
          <span class="journal-volume-arrow" aria-hidden="true">→</span>
        </span>
      </a>
    </section>

    <FolioLandscape />
  </main>
</BaseLayout>
