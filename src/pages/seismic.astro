---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/migration-stub.css';
---
<BaseLayout title="Seismic Station | Brambley" bodyClass="migration-stub-body">
  <main class="migration-stub">
    <div class="migration-stub__inner">
      <div class="migration-stub__eyebrow">BRAMBLEY MIGRATION PREVIEW</div>
      <h1>Seismic Station</h1>
      <p>The existing Raspberry Shake display and recent-capture feed will be migrated here from the current GitHub-backed workflow.</p>
      <nav aria-label="Migration preview navigation">
        <a href="/">Brambley</a>
        <a href="/observatory">Observatory</a>
      </nav>
    </div>
  </main>
</BaseLayout>