---
import BaseLayout from '../layouts/BaseLayout.astro';
import { notesCategories, type NoteCategory } from '../lib/notesTaxonomy';
import '../styles/notes.css';

interface Props {
  category: NoteCategory;
}

const { category } = Astro.props;
const config = notesCategories[category];

const artwork: Record<NoteCategory, string> = {
  garden: '/assets/notes/garden-index.webp',
  science: '/assets/notes/science-index.webp',
  chronicle: '/assets/notes/chronicle-index.webp'
};
---

<BaseLayout
  title={`${config.title} | Notes from Brambley`}
  description={config.subtitle}
  bodyClass="notes-page-body"
>
  <main class={`journal-index-page journal-index-page--${category}`}>
    <div class="journal-index-scroll">
      <div class="journal-index-canvas">
        <img
          class="journal-index-approved-art"
          src={artwork[category]}
          alt={`${config.title}, shown as an open illustrated journal index`}
        />

        <nav class="art-nav-hotspots art-nav-hotspots--index" aria-label="Brambley navigation">
          <a class="art-nav-hotspot art-nav-hotspot--home" href="/" aria-label="Home"></a>
          <a class="art-nav-hotspot art-nav-hotspot--observatory" href="/observatory" aria-label="Observatory"></a>
          <a class="art-nav-hotspot art-nav-hotspot--about" href="/about" aria-label="About"></a>
          <a class="art-nav-hotspot art-nav-hotspot--notes" href="/blog" aria-label="Notes" aria-current="page"></a>
        </nav>

        <a
          class="journal-index-return-hotspot"
          href="/blog"
          aria-label="Return to Notes"
          title="Return to Notes"
        ></a>
      </div>
    </div>
  </main>
</BaseLayout>
