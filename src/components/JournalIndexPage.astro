---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { notesCategories, type NoteCategory } from '../lib/notesTaxonomy';
import '../styles/notes.css';

interface Props {
  category: NoteCategory;
}

const { category } = Astro.props;
const config = notesCategories[category];

const artwork: Record<NoteCategory, string> = {
  garden: '/assets/notes/gardenBook-Folio.png',
  science: '/assets/notes/scienceNotes-folio.png',
  chronicle: '/assets/notes/chronicle-folio.png'
};

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .filter((entry) => entry.data.category === category)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const configuredNames = new Set(config.topics.map((topic) => topic.name));

const configuredGroups = config.topics
  .map((topic) => ({
    name: topic.name,
    page: topic.page,
    entries: notes.filter(
      (entry) => (entry.data.topic ?? 'Other Notes') === topic.name
    )
  }))
  .filter((group) => group.entries.length > 0);

let leftCount = configuredGroups.filter((group) => group.page === 'left').length;
let rightCount = configuredGroups.filter((group) => group.page === 'right').length;

const extraTopicNames = Array.from(
  new Set(notes.map((entry) => entry.data.topic ?? 'Other Notes'))
).filter((name) => !configuredNames.has(name));

const extraGroups = extraTopicNames.map((name) => {
  const page = leftCount <= rightCount ? 'left' : 'right';

  if (page === 'left') leftCount += 1;
  else rightCount += 1;

  return {
    name,
    page,
    entries: notes.filter(
      (entry) => (entry.data.topic ?? 'Other Notes') === name
    )
  };
});

const topicGroups = [...configuredGroups, ...extraGroups];

const leftGroups = topicGroups.filter((group) => group.page === 'left');
const rightGroups = topicGroups.filter((group) => group.page === 'right');

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric'
  }).format(date);
---

<BaseLayout
  title={`${config.title} | Notes from Brambley`}
  description={config.subtitle}
  bodyClass="notes-page-body notes-index-body"
>
  <main class={`approved-notes-page approved-index-page approved-index-page--${category}`}>
    <div class={`approved-notes-frame approved-index-frame approved-index-frame--${category}`}>
      <img
        class={`approved-notes-art ${category === 'garden' ? 'approved-notes-art--garden' : ''}`}
        src={artwork[category]}
        alt=""
        aria-hidden="true"
      />

      {category === 'garden' && (
        <>
          <img
            class="garden-ornament-art"
            src={artwork.garden}
            alt=""
            aria-hidden="true"
          />
          <div class="garden-heading-live">
            <h1>Garden Book</h1>
          </div>
        </>
      )}

      <nav class="approved-art-nav" aria-label="Brambley navigation">
        <a class="approved-nav approved-nav--home" href="/" aria-label="Home">{category === 'garden' ? 'Home' : null}</a>
        <a class="approved-nav approved-nav--observatory" href="/observatory" aria-label="Observatory">{category === 'garden' ? 'Observatory' : null}</a>
        <a class="approved-nav approved-nav--about" href="/about" aria-label="About">{category === 'garden' ? 'About' : null}</a>
        <a class="approved-nav approved-nav--notes" href="/blog" aria-label="Notes" aria-current="page">{category === 'garden' ? 'Notes' : null}</a>
      </nav>

      <div class={`live-index-overlay live-index-overlay--${category}`} aria-label={`${config.title} index`}>
        <section class="live-index-page live-index-page--left">
          <h2>INDEX</h2>
          <span class="live-index-title-rule" aria-hidden="true"></span>

          <div class="live-index-groups">
            {leftGroups.map((group) => (
              <section class="live-index-group">
                <h3><span>{group.name}</span></h3>
                <div class="live-index-entries">
                  {group.entries.map((entry) => (
                    <a class="live-index-entry" href={`/blog/${entry.id}`}>
                      <time datetime={entry.data.date.toISOString()}>
                        {formatDate(entry.data.date)}
                      </time>
                      <span>{entry.data.title}</span>
                    </a>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </section>

        <section class="live-index-page live-index-page--right">
          <div class="live-index-groups live-index-groups--right">
            {rightGroups.map((group) => (
              <section class="live-index-group">
                <h3><span>{group.name}</span></h3>
                <div class="live-index-entries">
                  {group.entries.map((entry) => (
                    <a class="live-index-entry" href={`/blog/${entry.id}`}>
                      <time datetime={entry.data.date.toISOString()}>
                        {formatDate(entry.data.date)}
                      </time>
                      <span>{entry.data.title}</span>
                    </a>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>
