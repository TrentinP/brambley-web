---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrambleyJournalNav from './BrambleyJournalNav.astro';
import BlackberryOrnament from './BlackberryOrnament.astro';
import FolioLandscape from './FolioLandscape.astro';
import { notesCategories, type NoteCategory, type NoteTopic } from '../lib/notesTaxonomy';
import '../styles/notes.css';

interface Props {
  category: NoteCategory;
}

const { category } = Astro.props;
const config = notesCategories[category];

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .filter((entry) => entry.data.category === category)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const configuredTopicNames = new Set(config.topics.map((topic) => topic.name));
const extraTopicNames = Array.from(
  new Set(
    notes
      .map((entry) => entry.data.topic ?? 'Other Notes')
      .filter((topic) => !configuredTopicNames.has(topic))
  )
);

const extraTopics: NoteTopic[] = extraTopicNames.map((name) => ({
  name,
  page: 'right'
}));

const topics = [...config.topics, ...extraTopics];
const leftTopics = topics.filter((topic) => topic.page === 'left');
const rightTopics = topics.filter((topic) => topic.page === 'right');

const notesForTopic = (topic: string) =>
  notes.filter((entry) => (entry.data.topic ?? 'Other Notes') === topic);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric'
  }).format(date);
---

<BaseLayout
  title={`${config.title} | Notes from Brambley`}
  description={config.subtitle}
  bodyClass="notes-page-body"
>
  <main class={`journal-index-page journal-index-page--${category}`}>
    <BrambleyJournalNav active="notes" />

    <header class="journal-index-hero">
      <h1>{config.title}</h1>
      <BlackberryOrnament />
      <p>{config.subtitle}</p>
    </header>

    <section class="journal-index-stage" aria-label={`${config.title} index`}>
      <div class={`open-journal open-journal--${category}`}>
        <svg
          class="open-journal-art"
          viewBox="0 0 1200 620"
          preserveAspectRatio="none"
          aria-hidden="true"
          focusable="false"
        >
          <defs>
            <filter id={`bookShadow-${category}`} x="-15%" y="-20%" width="130%" height="145%">
              <feDropShadow dx="0" dy="14" stdDeviation="14" flood-opacity=".18" />
            </filter>
            <linearGradient id={`paperLeft-${category}`} x1="0" x2="1">
              <stop offset="0" stop-color="#eadbbd" />
              <stop offset=".08" stop-color="#f4e8cf" />
              <stop offset=".92" stop-color="#f6ead2" />
              <stop offset="1" stop-color="#dfcfaf" />
            </linearGradient>
            <linearGradient id={`paperRight-${category}`} x1="0" x2="1">
              <stop offset="0" stop-color="#dfcfaf" />
              <stop offset=".08" stop-color="#f6ead2" />
              <stop offset=".92" stop-color="#f4e8cf" />
              <stop offset="1" stop-color="#eadbbd" />
            </linearGradient>
          </defs>

          <g filter={`url(#bookShadow-${category})`}>
            <rect class="open-journal-cover" x="42" y="38" width="1116" height="536" rx="22" />
            <path class="open-journal-page-edge" d="M64 72c13-20 35-31 66-31h454c22 0 42 10 58 25v489c-18-10-39-15-62-15H122c-29 0-49-8-58-24Z" />
            <path class="open-journal-page-edge" d="M1136 72c-13-20-35-31-66-31H616c-22 0-42 10-58 25v489c18-10 39-15 62-15h458c29 0 49-8 58-24Z" />
            <path fill={`url(#paperLeft-${category})`} d="M80 64c14-16 32-24 56-24h443c27 0 48 10 64 29v471c-21-13-44-19-70-19H129c-24 0-40-7-49-20Z" />
            <path fill={`url(#paperRight-${category})`} d="M1120 64c-14-16-32-24-56-24H621c-27 0-48 10-64 29v471c21-13 44-19 70-19h444c24 0 40-7 49-20Z" />
            <path class="open-journal-gutter" d="M600 64c-18 117-18 361 0 477" />
            <path class="open-journal-wear" d="M106 73c88-9 354-10 447-2M647 71c100-8 357-7 447 3M104 503c106 10 351 8 446 1M651 503c111 9 349 7 442 0" />
          </g>
        </svg>

        <div class="open-journal-content">
          <div class="journal-index-sheet journal-index-sheet--left">
            <h2>INDEX</h2>
            <span class="index-heading-rule" aria-hidden="true"></span>

            <div class="journal-topic-stack">
              {leftTopics.map((topic) => (
                <section class="journal-topic">
                  <h3><span>{topic.name}</span></h3>
                  <div class="journal-topic-entries">
                    {notesForTopic(topic.name).map((note) => (
                      <a class="journal-index-entry" href={`/blog/${note.id}/`}>
                        <time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>
                        <span>{note.data.title}</span>
                      </a>
                    ))}
                  </div>
                </section>
              ))}
            </div>
          </div>

          <div class="journal-index-sheet journal-index-sheet--right">
            <div class="journal-topic-stack journal-topic-stack--right">
              {rightTopics.map((topic) => (
                <section class="journal-topic">
                  <h3><span>{topic.name}</span></h3>
                  <div class="journal-topic-entries">
                    {notesForTopic(topic.name).map((note) => (
                      <a class="journal-index-entry" href={`/blog/${note.id}/`}>
                        <time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>
                        <span>{note.data.title}</span>
                      </a>
                    ))}
                  </div>
                </section>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <FolioLandscape />
  </main>
</BaseLayout>
