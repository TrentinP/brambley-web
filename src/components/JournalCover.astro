---
import type { NoteCategory } from '../lib/notesTaxonomy';

interface Props {
  category: NoteCategory;
}

const { category } = Astro.props;
---

<svg
  class={`journal-cover-art journal-cover-art--${category}`}
  viewBox="0 0 360 500"
  role="img"
  aria-label={
    category === 'garden'
      ? 'Green clothbound Garden Book'
      : category === 'science'
        ? 'Dark blue Science Field Notes notebook'
        : 'Brown Chronicle ledger bearing the Brambley crest'
  }
>
  <rect class="journal-pages-shadow" x="48" y="36" width="278" height="422" rx="8" />
  <path class="journal-page-edges" d="M50 54h278v397H50c9-19 12-44 12-72V120c0-28-4-50-12-66Z" />
  <rect class="journal-cover-base" x="31" y="24" width="286" height="420" rx="8" />
  <rect class="journal-cover-inner" x="43" y="36" width="262" height="396" rx="5" />
  <path class="journal-spine" d="M54 27c-11 42-10 363 0 414" />
  <path class="journal-wear" d="M48 49c35-8 211-11 249-2M50 415c48 7 199 8 244-1" />

  {category === 'garden' && (
    <>
      <text class="journal-cover-title" x="177" y="156" text-anchor="middle">
        <tspan x="177">Garden</tspan>
        <tspan x="177" dy="38">Book</tspan>
      </text>
      <g class="garden-glyph">
        <path d="M177 240c-2 38-2 70 0 111" />
        <path d="M177 267c-21-9-32-22-38-39 18 1 33 10 38 39Z" />
        <path d="M177 286c23-8 37-21 45-38-20 0-36 10-45 38Z" />
        <path d="M176 309c-18-6-29-16-36-30 17 0 30 9 36 30Z" />
        <path d="M177 329c19-6 32-16 40-31-18 0-32 9-40 31Z" />
        <path d="M167 231c4-10 10-16 18-19-1 10-6 17-18 19Z" />
      </g>
    </>
  )}

  {category === 'science' && (
    <>
      <text class="journal-cover-title journal-cover-title--science" x="177" y="150" text-anchor="middle">
        <tspan x="177">Science</tspan>
        <tspan x="177" dy="38">Field Notes</tspan>
      </text>
      <g class="science-glyph">
        <path d="M93 340l48-50 27 27 32-48 66 71" />
        <path d="M104 340c31-12 52-10 73-2 27 10 50 11 83 0" />
        <path d="M126 316l15-26 10 13M188 286l12-17 18 19" />
      </g>
    </>
  )}

  {category === 'chronicle' && (
    <>
      <rect class="chronicle-label" x="83" y="88" width="188" height="76" rx="2" />
      <rect class="chronicle-label-line" x="90" y="95" width="174" height="62" rx="1" />
      <text class="journal-cover-title journal-cover-title--chronicle" x="177" y="136" text-anchor="middle">Chronicle</text>

      <g class="chronicle-crest" transform="translate(96 210)">
        <path class="crest-wall" d="M9 116h163v35H9v-35Zm8-22h28v24H17V94Zm42 8h28v16H59v-16Zm43-8h28v24h-28V94Zm42 10h28v14h-28v-14Z" />
        <path class="crest-rope" d="M19 157c27-18 50 17 77 0s50 17 77 0" />
        <path class="crest-stem" d="M83 111c3-29 18-54 45-76" />
        <path class="crest-hand" d="M64 91c-6-9-4-19 4-24 6-4 11-1 15 5-1-12 2-20 10-21 8-1 11 7 12 17 2-13 6-21 14-20 8 1 9 9 8 20 5-10 11-15 18-11 8 5 6 15 1 25l-11 22H85Z" />
        <path class="crest-leaf" d="M120 35c-18-19-35-21-51-14 9 16 25 22 51 14Zm12-5c7-22 21-34 41-36-1 19-14 32-41 36Z" />
        <g class="crest-berries">
          <circle cx="150" cy="34" r="7" /><circle cx="162" cy="31" r="7" /><circle cx="174" cy="35" r="7" />
          <circle cx="154" cy="45" r="7" /><circle cx="167" cy="44" r="7" /><circle cx="179" cy="47" r="7" />
          <circle cx="160" cy="56" r="7" /><circle cx="173" cy="57" r="7" /><circle cx="166" cy="68" r="7" />
        </g>
      </g>
    </>
  )}
</svg>
